# All values are optional. Copy to .env and edit; empty values are treated as unset.

# Public URL of the deployed game. Used in share text and on the share card.
VITE_SITE_URL=http://localhost:5173

# Anonymous event endpoint (receives JSON via sendBeacon). Leave empty to disable analytics.
VITE_ANALYTICS_URL=

# Where the "get the printable 21:00 routine chart" button leads (e.g. a form or waitlist page).
# Leave empty to only record the click locally and show a thank-you message.
VITE_CTA_URL=
